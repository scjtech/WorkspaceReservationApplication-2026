        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    // Get the workspace_status field on the maintenance ticket
    // This tells us whether the workspace is still in maintenance
    var workspaceStatus = current.workspace_status.toString();

    // If the agent is trying to close the ticket but the workspace
    // status is still set to under maintenance, block the save
    // and show an error message — they must update the workspace
    // status first before closing
    if (workspaceStatus == 'in_maintenance') {

        // abortAction stops the record from saving entirely
        current.setAbortAction(true);

        // Display an error message to the user explaining why
        gs.addErrorMessage('You are unable to close this ticket because the workspace is still in maintenance.');
    }

})(current, previous);]]></script>
