        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue == '') {
        return;
    }

    //If End date/time is before Start date/time, show an error message

    g_form.clearMessages();

    var start = g_form.getValue('start_date_time');
    var end = g_form.getValue('end_date_time');

    if (end < start) {
        g_form.addErrorMessage('Error: Check out Date and Time is before the Check In Date.');
        g_form.clearValue('end_date_time');

    }
}]]></script>
