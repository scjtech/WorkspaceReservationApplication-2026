        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    // Get the sys_id of the workspace linked to this maintenance ticket
    var workspaceSysId = current.workspace.toString();

    // If no workspace is linked, stop the rule — nothing to update
    if (!workspaceSysId) return;

    // Query the Workspace Options table for the linked workspace record
    var ws = new GlideRecord('x_746154_workspa_0_workspace_options');

    // If the workspace record isn't found, stop the rule
    if (!ws.get(workspaceSysId)) return;

    // A maintenance ticket is now open, so mark the workspace
    // as Under Maintenance so no one can book it
    ws.status = 'under_maintenance';

    // Save the updated status back to the Workspace Options record
    ws.update();

})(current, previous);]]></script>
